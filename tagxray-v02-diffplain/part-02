+        const input=inputs[0];
+        if(!input)return false;
+        try{sessionStorage.setItem(key,'1');}catch{}
+        input.focus();
+        setNativeValue(input,query);
+        const form=input.closest('form');
+        if(form){
+          try{if(form.requestSubmit){form.requestSubmit();return true;}}catch{}
+          try{form.submit();return true;}catch{}
+        }
+        // Current Hmall/HiMart front pages also expose search via JS buttons.
+        const scope=input.parentElement?.parentElement || document;
+        const buttons=[...scope.querySelectorAll('button,a')];
+        const btn=buttons.find(b=>/검색|search/i.test((b.innerText||'')+' '+(b.getAttribute('aria-label')||'')+' '+(b.title||'')));
+        if(btn){btn.click();return true;}
+        try{
+          for(const type of ['keydown','keypress','keyup']) input.dispatchEvent(new KeyboardEvent(type,{key:'Enter',code:'Enter',keyCode:13,which:13,bubbles:true}));
+          return true;
+        }catch{return false;}
+      }
+
+      let submitted=false;
+      let ticks=0;
+      const timer=setInterval(()=>{
+        ticks++;
+        const rows=extract();
+        if(rows.length){
+          clearInterval(timer);
+          window.ReactNativeWebView.postMessage(JSON.stringify({kind:'result',provider,rows}));
+          return;
+        }
+        // Give the retailer JS a moment to hydrate before operating its own search box.
+        if(!submitted && ticks>=3){submitted=trySiteSearch();}
+        // Cloudflare + SPA hydration can take several seconds on a real phone.
+        if(now()-started>=10500){
+          clearInterval(timer);
+          window.ReactNativeWebView.postMessage(JSON.stringify({kind:'result',provider,rows:[]}));
+        }
+      },500);
+    })(); true;
+  `;
+}
+
+function Probe({cfg,variants,onResult,onDone}:{cfg:Config;variants:string[];onResult:(provider:Provider,offers:Offer[])=>void;onDone:(provider:Provider)=>void}){
+  const [variantIdx,setVariantIdx]=useState(0);
+  const [pageIdx,setPageIdx]=useState(0);
+  const [finished,setFinished]=useState(false);
+  const query=variants[variantIdx];
+  const pages=cfg.searchPages(query);
+  const uri=pages[Math.min(pageIdx,pages.length-1)];
+  const injected=useMemo(()=>script(cfg.id,variants,query),[cfg.id,variants.join('|'),query]);
+
+  const advance=()=>{
+    const currentPages=cfg.searchPages(variants[variantIdx]);
+    if(pageIdx<currentPages.length-1){setPageIdx(x=>x+1);return;}
+    if(variantIdx<variants.length-1){setPageIdx(0);setVariantIdx(x=>x+1);return;}
+    setFinished(true);onDone(cfg.id);
+  };
+
+  const handle=(e:WebViewMessageEvent)=>{
+    if(finished)return;
+    try{
+      const msg=JSON.parse(e.nativeEvent.data);
+      if(msg.kind!=='result')return;
+      const rows=Array.isArray(msg.rows)?msg.rows:[];
+      const offers:Offer[]=rows.map((r:any)=>{
+        const url=String(r.url||'');
+        const id=productId(cfg.id,url);
+        const price=Number(r.price);
+        if(!id||!url||!Number.isFinite(price))return null;
+        return {
+          provider:cfg.id,
+          providerProductId:id,
+          productName:String(r.title||'동일 상품'),
+          price,
+          finalPrice:price,
+          productUrl:url,
+          affiliateUrl:buildAffiliateUrl(cfg.id,url),
+          inStock:true,
+          matchConfidence:.98,
+          checkedAt:new Date().toISOString(),
+        } as Offer;
+      }).filter(Boolean) as Offer[];
+      if(offers.length){setFinished(true);onResult(cfg.id,offers);onDone(cfg.id);return;}
+      advance();
+    }catch{advance();}
+  };
+
+  if(finished)return null;
+  return <WebView
+    key={`${cfg.id}-${variantIdx}-${pageIdx}-${uri}`}
+    source={{uri}}
+    onMessage={handle}
+    onError={advance}
+    onHttpError={(e)=>{if(e.nativeEvent.statusCode>=400)advance();}}
+    injectedJavaScript={injected}
+    injectedJavaScriptForMainFrameOnly
+    javaScriptEnabled
+    domStorageEnabled
+    cacheEnabled={false}
+    thirdPartyCookiesEnabled
+    sharedCookiesEnabled
+    setSupportMultipleWindows={false}
+    originWhitelist={['https://*','http://*']}
+    userAgent="Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0.0.0 Mobile Safari/537.36"
+    style={s.web}
+  />;
+}
+
+export function RetailerWebSearch({rawCode,variants,onResult,onProviderDone}:{rawCode:string;variants:string[];brand?:string;onResult:(provider:Provider,offers:Offer[])=>void;onProviderDone:(provider:Provider)=>void}){
+  const vs=useMemo(()=>preferredVariants(rawCode,variants),[rawCode,variants.join('|')]);
+  return <View pointerEvents="none" style={s.host}>{CONFIGS.map(cfg=><Probe key={cfg.id} cfg={cfg} variants={vs} onResult={onResult} onDone={onProviderDone}/>)}</View>;
+}
+
+const s=StyleSheet.create({
+  host:{position:'absolute',left:-1200,top:0,width:390,height:760,overflow:'hidden',opacity:.01},
+  web:{width:390,height:760},
+});
