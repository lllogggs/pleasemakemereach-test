+import type {Offer} from './types';
+
+const A_CODE = process.env.EXPO_PUBLIC_LINKPRICE_A_CODE || 'A100707018';
+const LINK_CONFIG: Record<Offer['provider'], {domain:string;m:string;lCd1:string;lCd2:string}> = {
+  gmarket: {domain:'https://click.linkprice.com/click.php',m:'gmarket',lCd1:'D',lCd2:'H'},
+  lotteon: {domain:'https://click.linkprice.com/click.php',m:'lotteon',lCd1:'D',lCd2:'H'},
+  hmall: {domain:'https://lase.kr/click.php',m:'hmall',lCd1:'3',lCd2:'0'},
+  himart: {domain:'https://click.linkprice.com/click.php',m:'himart',lCd1:'D',lCd2:'H'},
+};
+
+export function buildAffiliateUrl(provider: Offer['provider'], productUrl: string) {
+  const cfg=LINK_CONFIG[provider];
+  const u=new URL(cfg.domain);
+  u.searchParams.set('m',cfg.m);
+  u.searchParams.set('a',A_CODE);
+  u.searchParams.set('l','9999');
+  u.searchParams.set('l_cd1',cfg.lCd1);
+  u.searchParams.set('l_cd2',cfg.lCd2);
+  u.searchParams.set('tu',productUrl);
+  return u.toString();
+}
