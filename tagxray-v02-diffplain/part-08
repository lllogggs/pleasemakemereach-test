+import type {Offer, SearchResponse} from './types';
+
+export function mergeOffers(...groups: Offer[][]): Offer[] {
+  const byProvider = new Map<Offer['provider'], Offer>();
+  for (const offer of groups.flat()) {
+    if (!offer.inStock || offer.matchConfidence < 0.9 || !Number.isFinite(offer.finalPrice) || offer.finalPrice <= 0) continue;
+    const prev = byProvider.get(offer.provider);
+    if (!prev || offer.finalPrice < prev.finalPrice || (offer.finalPrice === prev.finalPrice && offer.matchConfidence > prev.matchConfidence)) {
+      byProvider.set(offer.provider, offer);
+    }
+  }
+  return [...byProvider.values()].sort((a,b)=>a.finalPrice-b.finalPrice);
+}
+
+export function withOffers(base: SearchResponse, offers: Offer[], extraFailures: string[] = []): SearchResponse {
+  const merged = mergeOffers(base.offers, offers);
+  const lowest = merged[0] || null;
+  const storePrice = base.summary.storePrice;
+  const saving = lowest && storePrice != null ? storePrice - lowest.finalPrice : null;
+  const recommendation: SearchResponse['summary']['recommendation'] = !lowest
+    ? 'NO_ONLINE_STOCK'
+    : storePrice == null
+      ? 'ONLINE_FOUND'
+      : saving! > 0
+        ? 'ONLINE_WIN'
+        : saving! < 0
+          ? 'STORE_WIN'
+          : 'SAME_PRICE';
+  return {
+    ...base,
+    offers: merged,
+    failures: [...new Set([...base.failures, ...extraFailures])],
+    summary: {
+      ...base.summary,
+      lowestOnlinePrice: lowest?.finalPrice ?? null,
+      lowestProvider: lowest?.provider ?? null,
+      savingAmount: saving,
+      recommendation,
+    },
+  };
+}
