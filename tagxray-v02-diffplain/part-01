+  },
+  {
+    id:'lotteon',
+    base:'https://www.lotteon.com',
+    // mallId=2 catches department-store inventory (important for fashion),
+    // mallId=1 is kept as a second pass for the general mall inventory.
+    searchPages:q=>[
